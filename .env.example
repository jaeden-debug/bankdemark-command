# ============================================================
# BankDeMark Command — Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to version control
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── AI / LLM API ─────────────────────────────────────────
# Default: OpenAI. Can use any OpenAI-compatible API.
#
# For OpenAI:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
#
# For Anthropic (via proxy or Claude API adapter):
#   AI_BASE_URL=https://api.anthropic.com/v1
#   AI_MODEL=claude-3-haiku-20240307
#
# For local (Ollama, LM Studio, etc.):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3

AI_API_KEY=sk-your-api-key-here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: Stripe (for Pro subscriptions) ──────────────
# Add when you're ready to connect payments
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_MONTHLY_PRICE_ID=price_...
# STRIPE_YEARLY_PRICE_ID=price_...
# STRIPE_LIFETIME_PRICE_ID=price_...
