@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --surface-950: #080C14;
  --surface-900: #0D1117;
  --surface-800: #131923;
  --surface-700: #1A2332;
  --surface-600: #22304A;
  --brand-green: #00D084;
  --brand-gold: #F5C842;
  --brand-blue: #3B82F6;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  background-color: var(--surface-950);
  color: #E2E8F0;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  font-size: 15px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  min-height: 100vh;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: var(--surface-900);
}
::-webkit-scrollbar-thumb {
  background: #2C3E5A;
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: #3B5070;
}

/* Selection */
::selection {
  background: rgba(0, 208, 132, 0.25);
  color: #fff;
}

/* Glass card utility */
.glass-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.07);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 16px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}
.glass-card:hover {
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.12);
}

/* Score ring animation */
@keyframes ring-fill {
  from { stroke-dashoffset: 339.29; }
}

/* Print styles for reports */
@media print {
  body {
    background: #fff !important;
    color: #111 !important;
  }
  .no-print {
    display: none !important;
  }
  .print-card {
    break-inside: avoid;
    border: 1px solid #e2e8f0 !important;
    background: #f8fafc !important;
  }
  .print-white {
    background: #fff !important;
    color: #111 !important;
  }
}

/* Input styles */
.cmd-input {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  color: #E2E8F0;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  width: 100%;
  padding: 0.625rem 0.875rem;
  font-size: 0.9375rem;
  outline: none;
}
.cmd-input:focus {
  border-color: rgba(0, 208, 132, 0.5);
  box-shadow: 0 0 0 3px rgba(0, 208, 132, 0.1);
}
.cmd-input::placeholder {
  color: #4A5568;
}
.cmd-input:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Select styles */
.cmd-select {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  color: #E2E8F0;
  width: 100%;
  padding: 0.625rem 0.875rem;
  font-size: 0.9375rem;
  outline: none;
  appearance: none;
  cursor: pointer;
  transition: border-color 0.2s ease;
}
.cmd-select:focus {
  border-color: rgba(0, 208, 132, 0.5);
  box-shadow: 0 0 0 3px rgba(0, 208, 132, 0.1);
}
.cmd-select option {
  background: #131923;
  color: #E2E8F0;
}

/* Button styles */
.cmd-btn-primary {
  background: linear-gradient(135deg, #00D084, #00A866);
  color: #fff;
  border: none;
  border-radius: 10px;
  padding: 0.75rem 1.5rem;
  font-weight: 600;
  font-size: 0.9375rem;
  cursor: pointer;
  transition: opacity 0.2s ease, transform 0.1s ease, box-shadow 0.2s ease;
  box-shadow: 0 4px 16px rgba(0, 208, 132, 0.3);
}
.cmd-btn-primary:hover {
  opacity: 0.9;
  box-shadow: 0 6px 20px rgba(0, 208, 132, 0.4);
}
.cmd-btn-primary:active {
  transform: scale(0.98);
}
.cmd-btn-primary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.cmd-btn-secondary {
  background: rgba(255, 255, 255, 0.05);
  color: #CBD5E0;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  padding: 0.75rem 1.5rem;
  font-weight: 500;
  font-size: 0.9375rem;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease;
}
.cmd-btn-secondary:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.16);
}

.cmd-btn-ghost {
  background: transparent;
  color: #94A3B8;
  border: none;
  border-radius: 8px;
  padding: 0.5rem 0.875rem;
  font-size: 0.875rem;
  cursor: pointer;
  transition: color 0.2s ease, background 0.2s ease;
}
.cmd-btn-ghost:hover {
  color: #E2E8F0;
  background: rgba(255, 255, 255, 0.05);
}

/* Score color classes */
.score-critical { color: #EF4444; }
.score-vulnerable { color: #F97316; }
.score-stable { color: #EAB308; }
.score-strong { color: #22C55E; }
.score-elite { color: #00D084; }

/* Metric status colors */
.status-good { color: #00D084; }
.status-warn { color: #F5C842; }
.status-danger { color: #EF4444; }
.status-neutral { color: #94A3B8; }

/* Label */
.cmd-label {
  font-size: 0.8125rem;
  font-weight: 500;
  color: #64748B;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 0.375rem;
  display: block;
}

/* Animate in */
.animate-in {
  animation: slideUp 0.4s ease-out both;
}

/* =========================================================
   BANKDEMARK COMMAND — LIVE SITE THEME OVERRIDE
   Matches BankDeMark.com cream/navy/gold design system
========================================================= */

.bdm-command-shell {
  --bdm-ink: #0b1220;
  --bdm-navy: #0b1220;
  --bdm-muted: #667085;
  --bdm-soft: #f7f3ea;
  --bdm-cream: #fbf7ef;
  --bdm-gold: #c6a24a;
  --bdm-gold-light: #efd58a;
  --bdm-border: rgba(198, 162, 74, 0.18);
  --bdm-card: rgba(255, 255, 255, 0.72);

  color: var(--bdm-ink);
  background:
    radial-gradient(circle at 16% 6%, rgba(198,162,74,.22), transparent 34%),
    radial-gradient(circle at 92% 14%, rgba(11,18,32,.08), transparent 28%),
    linear-gradient(180deg, #fbf7ef 0%, #f4efe5 46%, #fbf7ef 100%) !important;
}

/* Core surface overrides */
.bdm-command-shell .bg-surface-950,
.bdm-command-shell .bg-surface-900,
.bdm-command-shell .bg-surface-800,
.bdm-command-shell .bg-surface-700 {
  background: transparent !important;
}

/* Sidebar / mobile nav */
.bdm-command-shell aside,
.bdm-command-shell header,
.bdm-command-shell nav.fixed {
  background: rgba(255,255,255,.72) !important;
  border-color: rgba(198,162,74,.18) !important;
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
  box-shadow:
    0 22px 70px rgba(15,23,42,.09),
    inset 0 1px 0 rgba(255,255,255,.82);
}

.bdm-command-shell aside {
  border-right: 1px solid rgba(198,162,74,.18) !important;
}

/* Cards */
.bdm-command-shell .glass-card,
.bdm-command-shell [class*="bg-white/3"],
.bdm-command-shell [class*="bg-white/4"],
.bdm-command-shell [class*="bg-white/5"] {
  background: rgba(255,255,255,.72) !important;
  border: 1px solid rgba(198,162,74,.18) !important;
  box-shadow:
    0 22px 70px rgba(15,23,42,.08),
    inset 0 1px 0 rgba(255,255,255,.86) !important;
  color: var(--bdm-ink) !important;
}

/* Text remap */
.bdm-command-shell .text-white,
.bdm-command-shell .text-slate-100,
.bdm-command-shell .text-slate-200,
.bdm-command-shell .text-slate-300 {
  color: var(--bdm-ink) !important;
}

.bdm-command-shell .text-slate-400,
.bdm-command-shell .text-slate-500,
.bdm-command-shell .text-slate-600 {
  color: var(--bdm-muted) !important;
}

.bdm-command-shell .text-brand-green,
.bdm-command-shell .status-good,
.bdm-command-shell .score-strong,
.bdm-command-shell .score-elite {
  color: var(--bdm-gold) !important;
}

/* Borders */
.bdm-command-shell .border-white\/5,
.bdm-command-shell .border-white\/6,
.bdm-command-shell .border-white\/10,
.bdm-command-shell .border-white\/20 {
  border-color: rgba(198,162,74,.18) !important;
}

/* Brand icon / active pills */
.bdm-command-shell [class*="from-brand-green"],
.bdm-command-shell [class*="to-brand-blue"] {
  background: linear-gradient(135deg, #0b1220, #1d2638) !important;
  box-shadow:
    0 12px 32px rgba(11,18,32,.14),
    inset 0 1px 0 rgba(255,255,255,.18);
}

.bdm-command-shell .bg-brand-green\/10,
.bdm-command-shell .bg-brand-green\/20 {
  background: rgba(198,162,74,.13) !important;
}

.bdm-command-shell .border-brand-green\/20 {
  border-color: rgba(198,162,74,.24) !important;
}

/* Inputs */
.bdm-command-shell .cmd-input,
.bdm-command-shell .cmd-select {
  background: rgba(255,255,255,.68) !important;
  border: 1px solid rgba(198,162,74,.22) !important;
  color: var(--bdm-ink) !important;
}

.bdm-command-shell .cmd-input:focus,
.bdm-command-shell .cmd-select:focus {
  border-color: rgba(198,162,74,.55) !important;
  box-shadow: 0 0 0 4px rgba(198,162,74,.13) !important;
}

.bdm-command-shell .cmd-input::placeholder {
  color: rgba(102,112,133,.72) !important;
}

/* Buttons */
.bdm-command-shell .cmd-btn-primary {
  background: linear-gradient(135deg, rgba(11,18,32,.96), rgba(11,18,32,.86)) !important;
  color: #fff !important;
  border-radius: 999px !important;
  box-shadow:
    0 22px 70px rgba(11,18,32,.18),
    0 0 34px rgba(198,162,74,.14),
    inset 0 1px 0 rgba(255,255,255,.18) !important;
}

.bdm-command-shell .cmd-btn-secondary,
.bdm-command-shell .cmd-btn-ghost {
  background: rgba(255,255,255,.58) !important;
  color: var(--bdm-ink) !important;
  border: 1px solid rgba(198,162,74,.18) !important;
}

/* Progress bars / accent colors */
.bdm-command-shell [style*="#00D084"],
.bdm-command-shell [style*="#22C55E"] {
  color: var(--bdm-gold) !important;
}

/* Keep danger/warning readable */
.bdm-command-shell .text-red-400,
.bdm-command-shell .status-danger {
  color: #b42318 !important;
}

/* Main layout breathing room */
.bdm-command-shell main {
  background: transparent !important;
}

/* Mobile spacing */
@media (max-width: 1023px) {
  .bdm-command-shell {
    padding-top: 64px;
    padding-bottom: 74px;
  }
}

/* =========================================================
   BANKDEMARK COMMAND — AI REPORT RESPONSE RENDERING
========================================================= */

.bdm-command-shell .ai-command-report {
  color: var(--bdm-ink);
}

.bdm-command-shell .ai-command-report strong {
  color: var(--bdm-ink);
  font-weight: 900;
}

.bdm-command-shell .ai-command-report p:first-child {
  margin-top: 0;
}

.bdm-command-shell .ai-command-report p:last-child {
  margin-bottom: 0;
}
