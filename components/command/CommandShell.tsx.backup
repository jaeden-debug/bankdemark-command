'use client';

import { useState, useEffect, useCallback } from 'react';
import { createClient } from '@/lib/supabase/client';
import type { User } from '@supabase/supabase-js';
import CommandNav from './CommandNav';
import CommandHero from './CommandHero';
import type { FinancialSnapshot, UserProfile } from '@/lib/command/types';
import { calcAllMetrics } from '@/lib/command/calculations';

interface AuthFormState {
  mode: 'sign_in' | 'sign_up';
  email: string;
  password: string;
  loading: boolean;
  error: string | null;
}

interface CommandShellProps {
  children: React.ReactNode;
  requiresAuth?: boolean;
}

export default function CommandShell({ children, requiresAuth = true }: CommandShellProps) {
  const supabase = createClient();
  const [user, setUser] = useState<User | null>(null);
  const [loading, setLoading] = useState(true);
  const [showAuth, setShowAuth] = useState(false);
  const [profile, setProfile] = useState<UserProfile | null>(null);
  const [snapshot, setSnapshot] = useState<FinancialSnapshot | null>(null);
  const [healthScore, setHealthScore] = useState<number | undefined>(undefined);

  const [auth, setAuth] = useState<AuthFormState>({
    mode: 'sign_up',
    email: '',
    password: '',
    loading: false,
    error: null,
  });

  const loadUserData = useCallback(async (userId: string) => {
    const [profileResult, snapshotResult] = await Promise.all([
      supabase.from('profiles').select('*').eq('id', userId).single(),
      supabase.from('financial_snapshots').select('*').eq('user_id', userId).order('updated_at', { ascending: false }).limit(1).single(),
    ]);
    if (profileResult.data) setProfile(profileResult.data);
    if (snapshotResult.data) {
      setSnapshot(snapshotResult.data);
      const metrics = calcAllMetrics(snapshotResult.data, profileResult.data?.age);
      setHealthScore(metrics.health_score);
    }
  }, [supabase]);

  useEffect(() => {
    supabase.auth.getUser().then(({ data: { user } }) => {
      setUser(user);
      if (user) loadUserData(user.id);
      setLoading(false);
    });

    const { data: { subscription } } = supabase.auth.onAuthStateChange((_event, session) => {
      setUser(session?.user ?? null);
      if (session?.user) {
        loadUserData(session.user.id);
        setShowAuth(false);
      }
    });
    return () => subscription.unsubscribe();
  }, [supabase, loadUserData]);

  const handleAuth = async (e: React.FormEvent) => {
    e.preventDefault();
    setAuth(a => ({ ...a, loading: true, error: null }));

    let error;
    if (auth.mode === 'sign_up') {
      const result = await supabase.auth.signUp({ email: auth.email, password: auth.password });
      error = result.error;
      if (!error && result.data.user) {
        // Insert stub profile
        await supabase.from('profiles').upsert({
          id: result.data.user.id,
          email: auth.email,
          first_name: '',
          age: 0,
          country: 'Canada',
          user_type: 'individual',
          household_type: 'single',
          business_owner: false,
        });
        window.location.href = '/command/onboarding';
      }
    } else {
      const result = await supabase.auth.signInWithPassword({ email: auth.email, password: auth.password });
      error = result.error;
      if (!error) window.location.href = '/command/dashboard';
    }

    if (error) {
      setAuth(a => ({ ...a, loading: false, error: error!.message }));
    }
  };

  // Redirect logged-in users from /command landing to dashboard
  useEffect(() => {
    if (!loading && user && typeof window !== 'undefined') {
      const path = window.location.pathname;
      if (path === '/command' || path === '/command/') {
        window.location.href = '/command/dashboard';
      }
    }
  }, [loading, user]);

  if (loading) {
    return (
      <div className="min-h-screen bg-surface-950 flex items-center justify-center">
        <div className="text-center">
          <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-green to-brand-blue flex items-center justify-center text-white font-bold text-lg mx-auto mb-4">B</div>
          <div className="text-slate-500 text-sm">Loading BankDeMark Command…</div>
        </div>
      </div>
    );
  }

  // Not logged in → always show hero + auth modal
  if (!user) {
    return (
      <>
        <CommandHero onAuthRequest={(mode) => { setAuth(a => ({ ...a, mode })); setShowAuth(true); }} />
        {showAuth && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm px-4">
            <div className="glass-card w-full max-w-md p-7 relative">
              <button
                onClick={() => setShowAuth(false)}
                className="absolute top-4 right-4 text-slate-500 hover:text-slate-300 transition-colors text-xl leading-none"
              >
                ✕
              </button>
              <div className="flex items-center gap-2.5 mb-6">
                <div className="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-green to-brand-blue flex items-center justify-center text-white font-bold text-sm">B</div>
                <div>
                  <div className="font-bold text-white text-sm">BankDeMark Command</div>
                  <div className="text-xs text-slate-500">{auth.mode === 'sign_up' ? 'Create your free account' : 'Welcome back'}</div>
                </div>
              </div>

              {/* Mode toggle */}
              <div className="flex bg-white/5 border border-white/10 rounded-xl p-1 mb-6">
                <button
                  onClick={() => setAuth(a => ({ ...a, mode: 'sign_up', error: null }))}
                  className={`flex-1 py-2 rounded-lg text-sm font-medium transition-all ${auth.mode === 'sign_up' ? 'bg-brand-green/20 text-brand-green' : 'text-slate-500 hover:text-slate-300'}`}
                >
                  Create Account
                </button>
                <button
                  onClick={() => setAuth(a => ({ ...a, mode: 'sign_in', error: null }))}
                  className={`flex-1 py-2 rounded-lg text-sm font-medium transition-all ${auth.mode === 'sign_in' ? 'bg-brand-green/20 text-brand-green' : 'text-slate-500 hover:text-slate-300'}`}
                >
                  Sign In
                </button>
              </div>

              <form onSubmit={handleAuth} className="space-y-4">
                <div>
                  <label className="cmd-label">Email</label>
                  <input
                    type="email"
                    className="cmd-input"
                    placeholder="you@example.com"
                    value={auth.email}
                    onChange={e => setAuth(a => ({ ...a, email: e.target.value }))}
                    required
                    autoFocus
                  />
                </div>
                <div>
                  <label className="cmd-label">Password</label>
                  <input
                    type="password"
                    className="cmd-input"
                    placeholder={auth.mode === 'sign_up' ? 'At least 8 characters' : '••••••••'}
                    value={auth.password}
                    onChange={e => setAuth(a => ({ ...a, password: e.target.value }))}
                    required
                    minLength={8}
                  />
                </div>
                {auth.error && (
                  <div className="text-sm text-red-400 bg-red-400/10 border border-red-400/20 rounded-lg px-3 py-2">
                    {auth.error}
                  </div>
                )}
                <button
                  type="submit"
                  className="cmd-btn-primary w-full py-3"
                  disabled={auth.loading}
                >
                  {auth.loading
                    ? 'Please wait…'
                    : auth.mode === 'sign_up'
                    ? 'Create Account & Start Free'
                    : 'Sign In to Dashboard'}
                </button>
              </form>

              <p className="text-xs text-slate-600 text-center mt-4">
                By continuing, you agree this is educational planning software.{' '}
                Not financial advice.
              </p>
            </div>
          </div>
        )}
      </>
    );
  }

  // Logged in → render app shell with nav
  return (
    <div className="min-h-screen bg-surface-950">
      <CommandNav
        userName={profile?.first_name || user?.email?.split('@')[0] || 'You'}
        healthScore={healthScore}
      />
      {/* Desktop: offset for sidebar. Mobile: offset for top header + bottom nav */}
      <main className="lg:ml-56 xl:ml-64 pt-0 lg:pt-0 min-h-screen">
        <div className="pt-16 lg:pt-0 pb-24 lg:pb-8">
          {children}
        </div>
      </main>
    </div>
  );
}
